; ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; CYLINDER_DEMO.gcode
; ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━
; Object    :  Cylinder  r=30 mm  h=4.0 mm
; Centre    :  X250  Y185  (mid-bed)
; Layers    :  20 × 0.2 mm  =  4.0 mm total height
; Perimeter :  36-segment polygon  (10° per step)
;
; Printer   :  Mock Klipper  –  cartesianxy3z  dual-carriage IDEX
; Axes      :  X   left/right toolhead
;              Y   front/back toolhead
;              Z   front-left  Z motor  (primary)
;              A   front-right Z motor  (tracks Z for flat layers)
;              B   rear-centre Z motor  (tracks Z for flat layers)
;
; T0 (left carriage)   layers  1 – 10
; T1 (right carriage)  layers 11 – 20
;
; Nozzle    :  ∅0.4 mm    Line width  0.45 mm
; Filament  :  PLA  ∅1.75 mm
; Temps     :  Nozzle 210 °C   Bed 60 °C
; Speeds    :  Print 40 mm/s   Travel 100 mm/s   Z 5 mm/s
; Extrusion :  ~7.05 mm filament per layer   total ~163 mm
; ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

; ── Start heaters (non-blocking) ────────────────────────────────────────
M83 ; relative extrusion (E values below are per-move amounts)
M140 S60
M104 T0 S210
M104 T1 S210

; ── Home all axes (X Y Z A B) ───────────────────────────────────────────
G28
G90
G0 Z5.000 A5.000 B5.000 F300

; ── 3-point automatic bed leveling ──────────────────────────────────────
Z_TILT_ADJUST

; ── Motion limits ───────────────────────────────────────────────────────
SET_VELOCITY_LIMIT VELOCITY=200 ACCEL=3000 Z_VELOCITY=8 Z_ACCEL=490

; ── Wait for temperatures ───────────────────────────────────────────────
M190 S60
M109 T0 S210
M109 T1 S210

; ── Live-Z offset: clear at start ───────────────────────────────────────
SET_GCODE_OFFSET Z=0.000

; ── Purge / prime line  T0  (left side  X15) ────────────────────────────
T0
G92 E0
G0 X15.000 Y5.000 Z0.300 A0.300 B0.300 F6000
G1 X15.000 Y120.000 E5.500 F1000
G1 X15.800 Y120.000 F6000
G1 X15.800 Y5.000 E11.000 F1000
G92 E0
G0 Z2.000 A2.000 B2.000 F300

; ── Purge / prime line  T1  (right side  X484) ──────────────────────────
T1
G92 E0
G0 X484.000 Y5.000 Z0.300 A0.300 B0.300 F6000
G1 X484.000 Y120.000 E5.500 F1000
G1 X484.800 Y120.000 F6000
G1 X484.800 Y5.000 E11.000 F1000
G92 E0
G0 Z2.000 A2.000 B2.000 F300

; ── Select T0;  part-cooling fan 30 % (warm-up layers 1-5) ─────────────
T0
M106 S77


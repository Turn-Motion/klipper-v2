; END PRINT
; ━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━━

; ── Heaters off ─────────────────────────────────────────────────────────
M106 S0                       ; part fan off
M104 T0 S0                    ; T0 heater off
M104 T1 S0                    ; T1 heater off
M140 S0                       ; bed heater off

; ── Lift all Z motors and park toolhead ─────────────────────────────────
G91
G0 Z5.000 A5.000 B5.000 F300
G90
G0 X15.000 Y5.000 F6000       ; park at front-left corner

; ── Reset all overrides ─────────────────────────────────────────────────
M220 S100                     ; speed factor 100%
M221 S100                     ; extrusion factor 100%
SET_GCODE_OFFSET Z=0.000      ; clear live-Z offset

; ── Motors off ──────────────────────────────────────────────────────────
M84


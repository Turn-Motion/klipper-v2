# Klipper build config — Linux host process MCU
# Pin enumeration happens at compile time from gpio_sim.c (or gpio.c)
#
# To regenerate interactively: make menuconfig → "Linux process" → save → make
CONFIG_LOW_LEVEL_OPTIONS=y
CONFIG_MACH_LINUX=y
CONFIG_LINUX_SELECT=y
CONFIG_CLOCK_FREQ=1000000
CONFIG_SERIAL_BAUD=250000
